# 复制为 .env.local 并填真值（.env*.local 已 gitignore）。
# settings fail-fast（suite-hard-rules §1），四键缺一不可。
DJANGO_SECRET_KEY=change-me-32-bytes-minimum-secret-key!
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/saas_dev
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
